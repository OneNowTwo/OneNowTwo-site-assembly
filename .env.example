# PostgreSQL connection string (Render injects this automatically from the database in render.yaml)
DATABASE_URL="postgresql://siteassembly:siteassembly@localhost:5432/site_assembly?schema=public"

# Random string, 32+ chars. Signs session cookies. `openssl rand -base64 32`
SESSION_SECRET=""

# Single internal admin login. Generate the hash with: npm run auth:hash -- 'your-password'
# In .env files escape every "$" in the hash as "\$" (Next.js expands $VARS). Paste unescaped on Render.
AUTH_EMAIL="admin@example.com"
AUTH_PASSWORD_HASH=""

# Optional overrides for the NSW data endpoints (defaults are the current official services)
# NSW_CADASTRE_URL="https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Land_Parcel_Property_Theme/FeatureServer"
# NSW_PLANNING_URL="https://mapprod3.environment.nsw.gov.au/arcgis/rest/services/Planning/EPI_Primary_Planning_Layers/MapServer"
# NEXT_PUBLIC_NSW_PLANNING_WMS_URL="https://mapprod3.environment.nsw.gov.au/arcgis/services/Planning/EPI_Primary_Planning_Layers/MapServer/WMSServer"
# GEOCODER_URL="https://nominatim.openstreetmap.org/search"

# Optional pedestrian router (default: public OSRM foot)
# WALKING_ROUTER_URL="https://router.project-osrm.org/route/v1/foot"
# WALKING_ROUTER_PROVIDER="OSRM foot (OpenStreetMap)"

# Domain Price Estimate API (OAuth Client Credentials)
# Create a project at https://developer.domain.com.au → Credentials → OAuth Client.
# Required API packages: Properties & Locations (suggest) AND Price Estimation (priceEstimate).
# Auth: HTTP Basic base64(client_id:client_secret) to DOMAIN_AUTH_URL with grant_type=client_credentials.
# DOMAIN_CLIENT_ID=""
# DOMAIN_CLIENT_SECRET=""
# DOMAIN_AUTH_URL="https://auth.domain.com.au/v1/connect/token"
# DOMAIN_API_BASE="https://api.domain.com.au"
# DOMAIN_SCOPES="api_properties_read api_addresslocators_read api_listings_read api_locations_read"
# VALUATION_PROVIDER="auto"   # auto | domain | proptrack

# PropTrack AVM — disabled until commercial credentials + PROPTRACK_ENABLED=true
# Do NOT scrape realestate.com.au.
# PROPTRACK_API_KEY=""
# PROPTRACK_ENABLED="false"
