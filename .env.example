# PostgreSQL connection string (Render injects this automatically from the database in render.yaml)
DATABASE_URL="postgresql://siteassembly:siteassembly@localhost:5432/site_assembly?schema=public"

# Random string, 32+ chars. Signs session cookies. `openssl rand -base64 32`
SESSION_SECRET=""

# Single internal admin login. Generate the hash with: npm run auth:hash -- 'your-password'
# In .env files escape every "$" in the hash as "\$" (Next.js expands $VARS). Paste unescaped on Render.
AUTH_EMAIL="admin@example.com"
AUTH_PASSWORD_HASH=""

# Optional overrides for the NSW data endpoints (defaults are the current official services)
# NSW_CADASTRE_URL="https://portal.spatial.nsw.gov.au/server/rest/services/NSW_Land_Parcel_Property_Theme/FeatureServer"
# NSW_PLANNING_URL="https://mapprod3.environment.nsw.gov.au/arcgis/rest/services/Planning/EPI_Primary_Planning_Layers/MapServer"
# NEXT_PUBLIC_NSW_PLANNING_WMS_URL="https://mapprod3.environment.nsw.gov.au/arcgis/services/Planning/EPI_Primary_Planning_Layers/MapServer/WMSServer"
