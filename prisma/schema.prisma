generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OpportunityStatus {
  WATCHING
  ANALYSING
  FEASIBLE
  ACQUIRING
  CONTROLLED
  REJECTED
  HOLD
}

enum AcquisitionStage {
  NOT_RESEARCHED
  OWNER_IDENTIFIED
  READY_TO_APPROACH
  LETTER_SENT
  DOOR_KNOCKED
  CONTACT_MADE
  INTERESTED
  PRICE_DISCUSSED
  OFFER_PREPARED
  OFFER_MADE
  NEGOTIATING
  OPTION_CONTRACT
  CONTROLLED
  DECLINED
  HOLD
}

/// LIVE_NSW: retrieved from NSW services; CACHED_NSW: real NSW data served from a stored snapshot; MANUAL: user-entered.
enum DataSource {
  LIVE_NSW
  CACHED_NSW
  MANUAL
}

enum ScenarioType {
  BASE
  UPSIDE
  DOWNSIDE
}

/// Acquisition comps = existing houses being bought; Exit comps = new product sales.
enum ComparableSaleType {
  ACQUISITION
  EXIT
}

enum MarketValueSource {
  USER_ESTIMATE
  COMPARABLE_DERIVED
  LIVE_PROVIDER
  LIVE_AVM
  SYSTEM_ESTIMATE
  SUBURB_FALLBACK
  DEMO
  NO_VALUE
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  lastLoginAt   DateTime?
  opportunities Opportunity[]
  watchItems    WatchItem[]
  alertRules    AlertRule[]
  morningReports MorningReport[]
}

model Opportunity {
  id                String              @id @default(cuid())
  name              String
  status            OpportunityStatus   @default(ANALYSING)
  suburb            String?
  lga               String?
  /// True when market values / owner details are fictional demo figures (shown as DEMO FINANCIAL DATA).
  demoFinancialData Boolean             @default(false)
  notes             String?
  /// Per-opportunity overrides of GlobalAssumptions, yield and feasibility inputs (JSON, validated with Zod).
  inputs            Json                @default("{}")
  // Cached summary of the latest BASE calculation, used for list views and sorting.
  score             Int?
  scoreFactors      Json?
  totalSiteArea     Float?
  grv               Float?
  /// Maximum payable to owners (purchase price P) — primary acquisition metric.
  maxLandBudget     Float?
  residualLandValue Float?
  profit            Float?
  marginOnCost      Float?
  combinedMarketValue Float?
  /// Max payable − combined existing property value.
  acquisitionHeadroom Float?
  acquisitionHeadroomPercent Float?
  /// Same as acquisition headroom — value created by assembling before negotiation.
  assemblyUplift    Float?
  theoreticalGfa    Float?
  achievableGfa     Float?
  saleableArea      Float?
  unitCount         Int?
  totalNonLandCost  Float?
  targetMoc         Float?
  createdById       String?
  createdBy         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  parcels           OpportunityParcel[]
  scenarios         FeasibilityScenario[]
  comparableSales   ComparableSale[]
  unitTypes         UnitType[]
  changeEvents      OpportunityChangeEvent[]
  feedItems         FeedItem[]
  watchItems        WatchItem[]

  @@index([status])
  @@index([updatedAt])
  @@index([acquisitionHeadroom])
}

model Parcel {
  id                 String              @id @default(cuid())
  /// Stable external id, e.g. "nsw-cadid:100104808".
  externalParcelId   String              @unique
  source             DataSource          @default(LIVE_NSW)
  lot                String?
  section            String?
  dp                 String?
  lotIdString        String?
  address            String?
  suburb             String?
  /// GeoJSON Polygon or MultiPolygon (WGS84).
  geometry           Json
  centroidLat        Float
  centroidLng        Float
  areaSqm            Float
  zone               String?
  zoneName           String?
  fsr                Float?
  heightM            Float?
  minLotSizeSqm      Float?
  heritage           String?
  planningInstrument String?
  lga                String?
  isStrata           Boolean             @default(false)
  planningCheckedAt  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  opportunities      OpportunityParcel[]
  snapshots          PlanningSnapshot[]
  comparableSales    ComparableSale[]
}

model OpportunityParcel {
  id                    String                @id @default(cuid())
  opportunityId         String
  opportunity           Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  parcelId              String
  parcel                Parcel                @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  sortOrder             Int                   @default(0)
  /// When false the lot is excluded from the assembly ("what if we can't get it").
  included              Boolean               @default(true)
  /// Estimated current market value of the existing property (acquisition-side).
  marketValue           Float?
  marketValueLow        Float?
  marketValueHigh       Float?
  marketValueSource     MarketValueSource?
  marketValueConfidence String?
  marketValueProvider   String?
  marketValueMethod     String?
  marketValueCheckedAt  DateTime?
  marketValueNote       String?
  landValuePerSqm       Float?
  comparableValue       Float?
  maxAllocationOverride Float?
  openingOfferOverride  Float?
  strategicWeight       Float?
  // Computed snapshot of the latest calculation (refreshed on every save).
  maximumOffer          Float?
  openingOffer          Float?
  negotiationHeadroom   Float?
  ownerPremiumAmount    Float?
  ownerPremiumPercent   Float?
  /// Legacy alias of opening premium ratio (kept for older clients).
  ownerPremium          Float?
  criticalityScore      Float?
  critical              Boolean?
  acquisitionStage      AcquisitionStage      @default(NOT_RESEARCHED)
  lastContactAt         DateTime?
  nextAction            String?
  nextActionDate        DateTime?
  approachNotes         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  owner                 OwnerContact?
  activities            AcquisitionActivity[]

  @@unique([opportunityId, parcelId])
  @@index([acquisitionStage])
}

model OwnerContact {
  id                  String            @id @default(cuid())
  opportunityParcelId String            @unique
  opportunityParcel   OpportunityParcel @relation(fields: [opportunityParcelId], references: [id], onDelete: Cascade)
  name                String?
  ownerType           String?
  phone               String?
  email               String?
  mailingAddress      String?
  notes               String?
  updatedAt           DateTime          @updatedAt
}

model AcquisitionActivity {
  id                  String            @id @default(cuid())
  opportunityParcelId String
  opportunityParcel   OpportunityParcel @relation(fields: [opportunityParcelId], references: [id], onDelete: Cascade)
  type                String
  note                String?
  activityDate        DateTime          @default(now())
  nextAction          String?
  nextActionDate      DateTime?
  stageFrom           AcquisitionStage?
  stageTo             AcquisitionStage?
  createdAt           DateTime          @default(now())

  @@index([opportunityParcelId, activityDate])
}

model FeasibilityScenario {
  id            String       @id @default(cuid())
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  name          String
  scenarioType  ScenarioType
  /// Scenario adjustments relative to the base inputs.
  assumptions   Json
  /// Last calculated results for this scenario.
  results       Json?
  updatedAt     DateTime     @updatedAt

  @@unique([opportunityId, scenarioType])
}

model GlobalAssumptions {
  id        String   @id @default("global")
  values    Json
  updatedAt DateTime @updatedAt
}

model PlanningSnapshot {
  id          String     @id @default(cuid())
  parcelId    String
  parcel      Parcel     @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  source      DataSource
  /// Full planning lookup result including per-field source and retrieval time.
  data        Json
  retrievedAt DateTime   @default(now())

  @@index([parcelId, retrievedAt])
}

/// Manual or provider-fed comparable sales. V1 is manual entry only — never scraped.
model ComparableSale {
  id              String             @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  parcelId        String?
  parcel          Parcel?            @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  type            ComparableSaleType
  address         String
  salePrice       Float
  saleDate        DateTime?
  propertyType    String?
  bedrooms        Float?
  bathrooms       Float?
  parking         Float?
  landArea        Float?
  internalArea    Float?
  externalArea    Float?
  saleableArea    Float?
  pricePerSqm     Float?
  /// For EXIT comps: NEW / RECENTLY_COMPLETED / ESTABLISHED
  newBuildStatus  String?
  unitType        String?
  source          String             @default("MANUAL")
  sourceReference String?
  included        Boolean            @default(true)
  notes           String?
  distanceM       Float?
  dataDate        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([opportunityId, type])
}

/// Residential unit mix row for UNIT_MIX revenue mode.
model UnitType {
  id               String      @id @default(cuid())
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  name             String
  sortOrder        Int         @default(0)
  count            Int         @default(0)
  avgInternalArea  Float       @default(0)
  avgExternalArea  Float       @default(0)
  avgSaleableArea  Float       @default(0)
  salePricePerUnit Float       @default(0)
  pricePerSqm      Float?
  revenue          Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([opportunityId])
}

// ─── Phase 2: stickiness / monitoring ───────────────────────────────────────

enum WatchItemKind {
  SUBURB
  MAP_AREA
  PRECINCT
  PARCEL
  OPPORTUNITY
}

enum ScanCadence {
  MANUAL
  DAILY
  WEEKLY
}

enum ScanJobStatus {
  IDLE
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum FeedKind {
  NEW
  IMPROVED
  DECLINED
  PLANNING_CHANGE
  NEW_SALE
  WATCHLIST_CHANGE
  ALERT
  REPORT
}

enum AlertChannel {
  IN_APP
  EMAIL
  PUSH
}

enum ChangeEventKind {
  STATUS
  SCORE
  HEADROOM
  MAX_PAYABLE
  GRV
  EXISTING_VALUE
  PLANNING
  PATHWAY
  COMPARABLE
  SALE
  ASSUMPTIONS
  OTHER
}

/// Saved area / parcel / opportunity on a user's watchlist.
model WatchItem {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind               WatchItemKind
  label              String
  /// Suburb name when kind=SUBURB / MAP_AREA hint.
  suburb             String?
  /// Optional GeoJSON bbox {west,south,east,north} for MAP_AREA / PRECINCT.
  bbox               Json?
  precinctId         String?
  externalParcelId   String?
  opportunityId      String?
  opportunity        Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// Filter criteria JSON (minSiteArea, minHeadroom, minScore, zoning, lots, pathway, …).
  filters            Json          @default("{}")
  notes              String?
  scanCadence        ScanCadence   @default(MANUAL)
  lastScanAt         DateTime?
  nextScanAt         DateTime?
  scanStatus         ScanJobStatus @default(IDLE)
  lastScanSummary    Json?
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  scanJobs           AreaScanJob[]
  alertRules         AlertRule[]

  @@index([userId, active])
  @@index([kind])
  @@index([nextScanAt])
}

/// Opportunity metric / narrative timeline — never silently overwrite history.
model OpportunityChangeEvent {
  id             String          @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind           ChangeEventKind
  title          String
  summary        String?
  /// Before snapshot (numbers / status / pathway labels).
  before         Json?
  /// After snapshot.
  after          Json?
  /// Why this change was recorded (sale id, planning id, user action…).
  reason         String?
  source         String?
  createdAt      DateTime        @default(now())

  @@index([opportunityId, createdAt])
  @@index([kind, createdAt])
}

/// Workspace feed — "what should I look at today?"
model FeedItem {
  id             String       @id @default(cuid())
  kind           FeedKind
  title          String
  summary        String?
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  watchItemId    String?
  href           String?
  /// Sort helpers persisted at write time.
  score          Int?
  headroom       Float?
  maxPayable     Float?
  scoreDelta     Int?
  headroomDelta  Float?
  importance     Float        @default(0)
  payload        Json?
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([importance])
  @@index([opportunityId])
}

/// User-defined alert criteria. Delivery channels expandable later.
model AlertRule {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean       @default(true)
  /// Criteria JSON: suburb, minScore, minHeadroom, minHeadroomPct, pathway, minLots, viable, …
  criteria       Json          @default("{}")
  watchItemId    String?
  watchItem      WatchItem?    @relation(fields: [watchItemId], references: [id], onDelete: SetNull)
  channels       AlertChannel[] @default([IN_APP])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  events         AlertEvent[]

  @@index([userId, active])
}

model AlertEvent {
  id             String     @id @default(cuid())
  ruleId         String
  rule           AlertRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  title          String
  summary        String?
  opportunityId  String?
  href           String?
  payload        Json?
  /// Delivery bookkeeping for future email/push.
  deliveredInApp Boolean    @default(true)
  deliveredEmail Boolean    @default(false)
  deliveredPush  Boolean    @default(false)
  readAt         DateTime?
  createdAt      DateTime   @default(now())

  @@index([ruleId, createdAt])
  @@index([createdAt])
}

/// Generated daily morning report (in-app first).
model MorningReport {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportDate     DateTime @db.Date
  title          String
  /// Structured sections JSON.
  body           Json
  summaryLine    String?
  createdAt      DateTime @default(now())

  @@unique([userId, reportDate])
  @@index([reportDate])
}

/// Scheduled / manual re-scan job for a saved area.
model AreaScanJob {
  id              String        @id @default(cuid())
  watchItemId     String
  watchItem       WatchItem     @relation(fields: [watchItemId], references: [id], onDelete: Cascade)
  status          ScanJobStatus @default(QUEUED)
  cadence         ScanCadence   @default(MANUAL)
  startedAt       DateTime?
  finishedAt      DateTime?
  resultsAdded    Int           @default(0)
  resultsChanged  Int           @default(0)
  resultsRemoved  Int           @default(0)
  summary         Json?
  error           String?
  createdAt       DateTime      @default(now())

  @@index([watchItemId, createdAt])
  @@index([status])
}

/// Deduped NSW registered sales observed by the monitor.
model MonitoredSale {
  id             String   @id @default(cuid())
  /// Stable key: dealing|propid|address|saleDate|price
  saleKey        String   @unique
  address        String
  suburb         String?
  salePrice      Float
  saleDate       DateTime?
  dealing        String?
  propid         Int?
  lng            Float?
  lat            Float?
  landAreaSqm    Float?
  raw            Json?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@index([suburb])
  @@index([saleDate])
}

/// Planning updates attributed to watched areas (proposed stays separate from current law).
model PlanningMonitorEvent {
  id             String   @id @default(cuid())
  changeKey      String
  title          String
  summary        String?
  status         String?
  suburb         String?
  watchItemId    String?
  opportunityId  String?
  /// Current vs proposed payload — proposed never applied to feasibility here.
  current        Json?
  proposed       Json?
  impact         String?
  sourceUrl      String?
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([changeKey, createdAt])
  @@index([createdAt])
}

// ─── Source Watcher / development intelligence engine ───────────────────────

enum SourceTransport {
  API
  ARCGIS
  WFS
  JSON
  HTML
  PDF
  RSS
  FIXTURE
  OTHER
}

enum SourceCategory {
  CURRENT_CONTROLS
  PLANNING_PROPOSAL
  STATE_LED_REZONING
  COUNCIL_STRATEGIC
  KEY_SITE
  HDA
  MAJOR_PROJECTS
  DA_CDC_PCC
  DCP
  COUNCIL_AGENDA
  ENVIRONMENT
  TRANSPORT
  PROPERTY_SALES
  OTHER
}

enum SourceRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  UNCHANGED
  FAILED
}

enum IntelChangeKind {
  PLANNING_PROPOSAL_CREATED
  PLANNING_STATUS_CHANGED
  ZONE_PROPOSED_CHANGE
  FSR_PROPOSED_CHANGE
  HEIGHT_PROPOSED_CHANGE
  KEY_SITE_CREATED
  KEY_SITE_CHANGED
  ASSEMBLY_REQUIREMENT_CHANGED
  AFFORDABLE_HOUSING_RATE_CHANGED
  DCP_CHANGED
  HDA_RECORD_PUBLISHED
  HDA_RECOMMENDATION_CHANGED
  SSD_DECLARED
  SSD_STATUS_CHANGED
  DA_LODGED
  DA_APPROVED
  PCC_ISSUED
  COUNCIL_RESOLUTION
  ENVIRONMENTAL_LAYER_CHANGED
  SOURCE_REFRESHED
  OTHER
}

/// Catalog of official / fixture sources the Source Watcher polls.
model SourceRegistry {
  id              String         @id
  name            String
  authority       String
  category        SourceCategory
  jurisdiction    String         @default("NSW")
  sourceType      SourceTransport
  /// Adapter id + fetch config (URLs, layer ids, poll hints).
  config          Json           @default("{}")
  pollFrequency   String
  parserVersion   String         @default("1")
  licence         String?
  lastCheckedAt   DateTime?
  lastSuccessfulAt DateTime?
  lastContentHash String?
  etag            String?
  enabled         Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  runs            SourceRun[]
  snapshots       SourceSnapshot[]

  @@index([category, enabled])
  @@index([enabled, lastCheckedAt])
}

model SourceRun {
  id             String         @id @default(cuid())
  sourceId       String
  source         SourceRegistry @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status         SourceRunStatus @default(QUEUED)
  startedAt      DateTime?
  finishedAt     DateTime?
  contentHash    String?
  snapshotId     String?
  eventsCreated  Int            @default(0)
  error          String?
  notes          String?
  createdAt      DateTime       @default(now())

  @@index([sourceId, createdAt])
  @@index([status, createdAt])
}

/// Immutable raw/normalised payload for a source fetch — never silently overwritten.
model SourceSnapshot {
  id               String         @id @default(cuid())
  sourceId         String
  source           SourceRegistry @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  retrievedAt      DateTime       @default(now())
  contentHash      String
  sourceModifiedAt DateTime?
  parserVersion    String
  /// Raw upstream payload or fixture pointer.
  raw              Json?
  /// Normalised intelligence payload used for diffing.
  normalised       Json
  createdAt        DateTime       @default(now())

  @@index([sourceId, retrievedAt])
  @@unique([sourceId, contentHash])
}

/// System-wide intelligence change events (feeds TODAY; proposed ≠ current law).
model IntelChangeEvent {
  id             String          @id @default(cuid())
  kind           IntelChangeKind
  title          String
  summary        String?
  sourceId       String?
  snapshotId     String?
  /// Stable dedupe key for unchanged re-runs.
  changeKey      String
  oldValue       Json?
  newValue       Json?
  /// Affected geometry GeoJSON or bbox JSON.
  geometry       Json?
  affectedParcelHints Json?
  watchItemIds   Json?
  href           String?
  importance     Float           @default(0)
  payload        Json?
  createdAt      DateTime        @default(now())

  @@unique([changeKey])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@index([sourceId, createdAt])
}

/// Proposed / pending planning change area (never treated as current LEP law).
model PlanningChangeArea {
  id             String   @id
  title          String
  status         String
  authority      String?
  lgas           String[] @default([])
  suburbs        String[] @default([])
  sourceId       String?
  sourceUrl      String?
  exhibitionEnd  DateTime?
  /// Approximate envelope for screening.
  bbox           Json?
  geometry       Json?
  /// Proposed controls payload (FSR/height/zone/AH/etc.) — PROPOSED only.
  proposedControls Json   @default("{}")
  lastCheckedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  keySites       KeySite[]

  @@index([status])
}

/// Key site / assembly rule within a PlanningChangeArea.
model KeySite {
  id                   String             @id
  planningChangeAreaId String
  planningChangeArea   PlanningChangeArea @relation(fields: [planningChangeAreaId], references: [id], onDelete: Cascade)
  externalKeySiteId    String
  name                 String
  geometry             Json?
  bbox                 Json?
  requiredParcelHints  Json?
  optionalParcelHints  Json?
  currentControls      Json?
  proposedControls     Json?
  incentiveControls    Json?
  requirements         Json?
  conditions           Json?
  sourceUrl            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([planningChangeAreaId, externalKeySiteId])
  @@index([externalKeySiteId])
}
